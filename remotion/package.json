{
  "name": "remotion-videos",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto Remotion para generar y editar vídeos automáticamente",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts MiVideo out/video.mp4",
    "render:props": "remotion render src/index.ts MiVideo out/video.mp4 --props=./props.json",
    "batch": "node scripts/render-batch.mjs",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
